{# Comparación de dos jugadores: esta temporada y su carrera en ligas nacionales. Gana (acento) quien tiene el mejor dato. #}
<style>
.cmp { flex: 1; display: flex; flex-direction: column; margin-top: 40px; position: relative; z-index: 2; }
.cmp-tit { font-family: var(--f-tit); font-size-adjust: cap-height var(--aj-tit, .64); }
.cmp-num { font-family: var(--f-num, var(--f-tit)); font-size-adjust: cap-height var(--aj-num, .64); font-variant-numeric: tabular-nums; }
.cmp-kick { font-size: 26px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--acento-txt); }
.cmp-cab { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 22px; }
.cmp-j { min-width: 0; }
.cmp-j.b { text-align: right; }
.cmp-j .p { font-size: 34px; color: var(--gris); line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmp-j .a { font-weight: 700; font-size: 64px; line-height: .9; text-transform: uppercase; margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmp-j .e { display: flex; align-items: center; gap: 12px; margin-top: 14px; font-size: 27px; font-weight: 600; }
.cmp-j.b .e { justify-content: flex-end; }
.cmp-j .e .crest { width: 54px; height: 54px; padding: 5px; flex: none; }
.cmp-j .e span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cmp-sec { margin-top: 30px; padding-bottom: 8px; border-bottom: 2px solid var(--linea); font-size: 23px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--gris); }
.cmp-f { display: grid; grid-template-columns: 1fr 250px 1fr; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--linea); }
.cmp-f .v { font-size: 56px; line-height: .95; }
.cmp-f .v.b { text-align: right; }
.cmp-f .v.gana { color: var(--acento-txt); }
.cmp-f .k { text-align: center; font-size: 22px; color: var(--gris); text-transform: uppercase; letter-spacing: 2px; }
.f-historia .cmp { margin-top: 110px; }
.f-historia .cmp-f { padding: 20px 0; }
</style>
{% set na = s.a.nombre|jugador %}
{% set nb = s.b.nombre|jugador %}
<div class="cmp">
  <div class="cmp-kick">Cara a cara de jugadores</div>
  <div class="cmp-cab">
    <div class="cmp-j a">
      <div class="p cmp-tit">{{ na.nombre }}</div>
      <div class="a cmp-tit">{{ na.apellidos }}</div>
      <div class="e">{% if s.a.equipo|escudo %}<img class="crest" src="{{ s.a.equipo|escudo }}">{% endif %}<span>{{ s.a.equipo|corto }}</span></div>
    </div>
    <div class="cmp-j b">
      <div class="p cmp-tit">{{ nb.nombre }}</div>
      <div class="a cmp-tit">{{ nb.apellidos }}</div>
      <div class="e">{% if s.b.equipo|escudo %}<img class="crest" src="{{ s.b.equipo|escudo }}">{% endif %}<span>{{ s.b.equipo|corto }}</span></div>
    </div>
  </div>
  {% for f in s.filas %}
    {% if f.seccion %}
    <div class="cmp-sec">{{ f.seccion }}</div>
    {% else %}
    <div class="cmp-f">
      <div class="v cmp-num{{ ' gana' if f.gana == 'a' }}">{{ f.a }}</div>
      <div class="k">{{ f.k }}</div>
      <div class="v b cmp-num{{ ' gana' if f.gana == 'b' }}">{{ f.b }}</div>
    </div>
    {% endif %}
  {% endfor %}
</div>
